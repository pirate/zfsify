[0.0, "o", "\u001b[?25l\u001b[1;1HFilesystem      Size  Used Avail Use% Mounted on                                                              \u001b[2;1H/dev/vda1        24G  2.0G   22G   9% /                                                                       \u001b[4;1Htotal 129M                                                                                                    \u001b[5;1H-rw-r--r-- 1 root root   32 Sep  7 07:08 README.txt                                                           \u001b[6;1H-rw-r--r-- 1 root root 128M Sep  7 07:08 database.bin                                                         \u001b[8;1H+ curl -fsSL http://127.0.0.1:8765/reformat.sh                                                                \u001b[9;1H+ bash                                                                                                        \u001b[10;1HRoot filesystem: /dev/vda1 on /dev/vda | used 8.50% (2115194880 / 24883167232 bytes)                          "]
[3.0, "o", "\u001b[1;1HPRESERVE: your Ubuntu installation, users, applications and files move to ZFS.                                \u001b[2;1HDevices: source /dev/vda1; temporary /dev/vda32; final /dev/vda2.                                             \u001b[3;1H/dev/vda (512 MiB ZFSBootMenu partition omitted):                                                             \u001b[4;1H  [              original ext4              ]                                                                 \u001b[5;1H  [       smaller ext4      ][ temporary ZFS ]  shrink offline; copy + verify                                 \u001b[6;1H  [       new ZFS member    ][ temporary ZFS ]  attach mirror; resilver                                       \u001b[7;1H  [       new ZFS member    ][ free space    ]  detach temporary member                                       \u001b[8;1H  [                   ZFS                   ]  grow; / and /boot on ZFS                                       \u001b[9;1HThe server reboots into RAM. Services are offline during migration.                                           \u001b[10;1HOriginal ext4 is removed only after the copy is checksum-verified.                                            \u001b[11;1HPower loss during repartitioning can require provider recovery.                                               "]
