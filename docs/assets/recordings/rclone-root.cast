[0.0, "o", "\u001b[?25l\u001b[1;1Hdf -h /; du -h /srv/demo/archive.bin                                                                          \u001b[3;1HFilesystem      Size  Used Avail Use% Mounted on                                                              \u001b[4;1H/dev/vda1        24G   15G  9.1G  62% /                                                                       \u001b[5;1H13G     /srv/demo/archive.bin                                                                                 \u001b[6;1Hroot@zfsify:~# curl -fsSL http://127.0.0.1:8765/reformat.sh | sh                                              \u001b[8;1HRoot filesystem: /dev/vda1 on /dev/vda | used 60.99% (15177285632 / 24883167232 bytes)                        "]
[4.0, "o", "\u001b[1;1H!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!                                      \u001b[2;1H!! WARNING: ROOT IS AT LEAST 50% USED. PRESERVATION IS NOT ELIGIBLE.     !!                                   \u001b[3;1H!! A: rclone backup, verify, reformat, then restore the full system.    !!                                    \u001b[4;1H!! B: erase and install fresh Ubuntu with a limited priority restore.   !!                                    \u001b[5;1H!! Applications and data are deleted. /etc, users, SSH keys and        !!                                     \u001b[6;1H!! basic settings survive. There is no automatic fallback to erasure. !!                                      \u001b[7;1H!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!                                      \u001b[8;1HChoose A for rclone backup/restore, or B (or y) for an ERASE install: A                                       "]
[9.0, "o", "\u001b[1;1HBACKUP AND RESTORE: offline tar archive -> rclone remote -> full read-back verification -> erase /dev/vda -> Z\u001b[2;1HFS -> restore archive.                                                                                        \u001b[3;1HThe remote backup remains available after completion.                                                         \u001b[4;1H                                                                                                              \u001b[5;1H                                                                                                              \u001b[6;1H                                                                                                              \u001b[7;1H                                                                                                              \u001b[8;1H                                                                                                              "]
