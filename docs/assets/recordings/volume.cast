[0.0, "o", "\u001b[?25l\u001b[1;1H$ lsblk -o NAME,SIZE,FSTYPE,MOUNTPOINTS                                                                       \u001b[2;1HNAME     SIZE FSTYPE  MOUNTPOINTS                                                                             \u001b[3;1Hsda        1G ext4    /mnt/data                                                                               \u001b[4;1Hvda       25G                                                                                                 \u001b[5;1H|-vda1    24G ext4    /                                                                                       \u001b[6;1H|-vda14    4M                                                                                                 \u001b[7;1H|-vda15  106M vfat    /boot/efi                                                                               \u001b[8;1H`-vda16  913M ext4    /boot                                                                                   \u001b[9;1Hvdb      488K iso9660                                                                                         \u001b[11;1H$ df -h /mnt/data                                                                                             \u001b[12;1HFilesystem      Size  Used Avail Use% Mounted on                                                              \u001b[13;1H/dev/sda        974M  181M  727M  20% /mnt/data                                                               "]
