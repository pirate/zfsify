[260.317, "o", "2026/09/07 07:18:22 NOTICE: Config file \"/root/.config/rclone/rclone.conf\" not found - using defaults\r\nNo remotes found, make a new one?\r\nn) New remote\r\ns) Set configuration password\r\nq) Quit config\r\n"]
[260.319, "o", "n/s/q> "]
[280.299, "o", "n\r\nbackup\r\nsftp\r\n134.199.218.139\r\nbackup\r\n2022\r\ny\r\n\r\nEnter name for new remote.\r\nname> \r\nOption Storage.\r\nType of storage to configure.\r\nChoose a number from below, or type in your own value."]
[280.3, "o", "\r\n\u001b[91m 1 / 1Fichier\r\n   \\ (fichier)\r\n\u001b[0m\u001b[92m 2 / Akamai NetStorage\r\n   \\ (netstorage)\r\n\u001b[0m\u001b[91m 3 / Alias for an existing remote\r\n   \\ (alias)\r\n\u001b[0m\u001b[92m 4 / Amazon Drive\r\n   \\ (amazon cloud drive)\r\n\u001b[0m\u001b[91m 5 / Amazon S3 Compliant Storage Providers including AWS, Alibaba, Ceph, China Mobile, Cloudflare, ArvanCloud, Digital Ocean, Dreamhost, Huawei OBS, IBM COS, IDrive e2, IONOS Cloud, Lyve Cloud, Minio, Netease, RackCorp, Scaleway, SeaweedFS, StackPath, Storj, Tencent COS, Qiniu and Wasabi\r\n   \\ (s3)\r\n\u001b[0m\u001b[92m 6 / Backblaze B2\r\n   \\ (b2)\r\n\u001b[0m\u001b[91m 7 / Better checksums for other remotes\r\n   \\ (hasher)\r\n\u001b[0m\u001b[92m 8 / Box\r\n   \\ (box)\r\n\u001b[0m\u001b[91m 9 / Cache a remote\r\n   \\ (cache)\r\n\u001b[0m\u001b[92m10 / Citrix Sharefile\r\n   \\ (sharefile)\r\n\u001b[0m\u001b[91m11 / Combine several remotes into one\r\n   \\ (combine)\r\n\u001b[0m\u001b[92m12 / Compress a remote\r\n   \\ (compress)\r\n\u001b[0m\u001b[91m13 / Dropbox\r\n   \\ (dropbox)\r\n\u001b[0m\u001b[92m14 / Encrypt/Decrypt a remote\r\n   \\ (crypt)\r\n\u001b[0m\u001b[91m15 / Enterprise File Fabric\r\n   \\ (filefabric)\r\n\u001b[0m\u001b[92m16 / FTP\r"]
[280.3, "o", "\n   \\ (ftp)\r\n\u001b[0m\u001b[91m17 / Google Cloud Storage (this is not Google Drive)\r\n   \\ (google cloud storage)\r\n\u001b[0m\u001b[92m18 / Google Drive\r\n   \\ (drive)\r\n\u001b[0m\u001b[91m19 / Google Photos\r\n   \\ (google photos)\r\n\u001b[0m\u001b[92m20 / HTTP\r\n   \\ (http)\r\n\u001b[0m\u001b[91m21 / Hadoop distributed file system\r\n   \\ (hdfs)\r\n\u001b[0m\u001b[92m22 / HiDrive\r\n   \\ (hidrive)\r\n\u001b[0m\u001b[91m23 / In memory object storage system.\r\n   \\ (memory)\r\n\u001b[0m\u001b[92m24 / Internet Archive\r\n   \\ (internetarchive)\r\n\u001b[0m\u001b[91m25 / Jottacloud\r\n   \\ (jottacloud)\r\n\u001b[0m\u001b[92m26 / Koofr, Digi Storage and other Koofr-compatible storage providers\r\n   \\ (koofr)\r\n\u001b[0m\u001b[91m27 / Local Disk\r\n   \\ (local)\r\n\u001b[0m\u001b[92m28 / Mail.ru Cloud\r\n   \\ (mailru)\r\n\u001b[0m\u001b[91m29 / Microsoft Azure Blob Storage\r\n   \\ (azureblob)\r\n\u001b[0m\u001b[92m30 / Microsoft OneDrive\r\n   \\ (onedrive)\r\n\u001b[0m\u001b[91m31 / OpenDrive\r\n   \\ (opendrive)\r\n\u001b[0m\u001b[92m32 / OpenStack Swift (Rackspace Cloud Files, Memset Memstore, OVH)\r\n   \\ (swift)\r\n\u001b[0m\u001b[91m33 / Pcloud\r\n   \\ (pcloud)\r\n\u001b[0m\u001b[92m34 / Put.io\r\n   \\ (putio)\r\n\u001b[0m\u001b[91m35 / SMB / CIFS\r\n   \\ (s"]
[280.3, "o", "mb)\r\n\u001b[0m\u001b[92m36 / SSH/SFTP\r\n   \\ (sftp)\r\n\u001b[0m\u001b[91m37 / Sia Decentralized Cloud\r\n   \\ (sia)\r\n\u001b[0m\u001b[92m38 / Sugarsync\r\n   \\ (sugarsync)\r\n\u001b[0m\u001b[91m39 / Transparently chunk/split large files\r\n   \\ (chunker)\r\n\u001b[0m\u001b[92m40 / Union merges the contents of several upstream fs\r\n   \\ (union)\r\n\u001b[0m\u001b[91m41 / Uptobox\r\n   \\ (uptobox)\r\n\u001b[0m\u001b[92m42 / WebDAV\r\n   \\ (webdav)\r\n\u001b[0m\u001b[91m43 / Yandex Disk\r\n   \\ (yandex)\r\n\u001b[0m\u001b[92m44 / Zoho\r\n   \\ (zoho)\r\n\u001b[0m\u001b[91m45 / premiumize.me\r\n   \\ (premiumizeme)\r\n\u001b[0m\u001b[92m46 / seafile\r\n   \\ (seafile)\r\n\u001b[0mStorage> \r\nOption host.\r\n"]
[280.3, "o", "SSH host to connect to.\r\nE.g. \"example.com\".\r\nEnter a value.\r\nhost> "]
[280.302, "o", "\r\n"]
[280.303, "o", "Option user.\r\nSSH username.\r\nEnter a string value. Press Enter for the default (root).\r\nuser> \r\n"]
[280.304, "o", "Option port.\r\nSSH port number.\r\nEnter a signed integer. Press Enter for the default (22).\r\nport> \r\n"]
[280.305, "o", "Option pass."]
[280.305, "o", "\r\nSSH password, leave blank to use ssh-agent."]
[280.305, "o", "\r\nChoose an alternative below. Press Enter for the default (n).\r\ny) Yes, type in my own password\r\ng) Generate random password\r\nn) No, leave this optional password blank (default)\r\ny/g/n> Enter the password:"]
[280.305, "o", "\r\npassword:"]
[292.741, "o", "\r\n"]
[292.745, "o", "Confirm the password:\r\npassword:"]
[299.156, "o", "\r\n\r\n"]
[299.158, "o", "Option key_pem.\r\nRaw PEM-encoded private key.\r\nIf specified, will override key_file parameter.\r\nEnter a value. Press Enter to leave empty.\r\nkey_pem> "]
[307.775, "o", "\r\n\r\nOption key_file.\r\nPath to PEM-encoded private key file.\r\nLeave blank or set key-use-agent to use ssh-agent.\r\nLeading `~` will be expanded in the file name as will environment variables such as `${RCLONE_CONFIG_DIR}`.\r\nEnter a value. Press Enter to leave empty.\r\nkey_file> "]
[318.156, "o", "\r\n\r\nOption key_file_pass.\r\nThe passphrase to decrypt the PEM-encoded private key file.\r\nOnly PEM encrypted key files (old OpenSSH format) are supported. Encrypted keys\r\nin the new OpenSSH format can't be used.\r\nChoose an alternative below. Press Enter for the default (n).\r\ny) Yes, type in my own password\r\ng) Generate random password\r\nn) No, leave this optional password blank (default)\r\ny/g/n> "]
[324.416, "o", "\r\n\r\nOption pubkey_file.\r\nOptional path to public key file.\r\nSet this if you have a signed certificate you want to use for authentication.\r\nLeading `~` will be expanded in the file name as will environment variables such as `${RCLONE_CONFIG_DIR}`.\r\nEnter a value. Press Enter to leave empty.\r\npubkey_file> "]
[332.061, "o", "\r\n\r\nOption key_use_agent.\r\nWhen set forces the usage of the ssh-agent.\r\nWhen key-file is also set, the \".pub\" file of the specified key-file is read and only the associated key is\r\nrequested from the ssh-agent. This allows to avoid `Too many authentication failures for *username*` errors\r\nwhen the ssh-agent contains many keys.\r\nEnter a boolean value (true or false). Press Enter for the default (false).\r\nkey_use_agent> "]
[338.455, "o", "\r\n\r\nOption use_insecure_cipher.\r\nEnable the use of insecure ciphers and key exchange methods.\r\nThis enables the use of the following insecure ciphers and key exchange methods:\r\n- aes128-cbc\r\n- aes192-cbc\r\n- aes256-cbc\r\n- 3des-cbc\r\n- diffie-hellman-group-exchange-sha256\r\n- diffie-hellman-group-exchange-sha1\r\nThose algorithms are insecure and may allow plaintext data to be recovered by an attacker.\r\nChoose a number from below, or type in your own boolean value (true or false).\r\nPress Enter for the default (false).\r\n\u001b[91m 1 / Use default Cipher list.\r\n   \\ (false)\r\n\u001b[0m\u001b[92m 2 / Enables the use of the aes128-cbc cipher and diffie-hellman-group-exchange-sha256, diffie-hellman-group-exchange-sha1 key exchange.\r\n   \\ (true)\r\n\u001b[0muse_insecure_cipher> "]
[344.649, "o", "\r\n\r\nOption disable_hashcheck.\r\nDisable the execution of SSH commands to determine if remote file hashing is available."]
[344.649, "o", "\r\nLeave blank or set to false to enable hashing (recommended), set to true to disable hashing.\r\nEnter a boolean value (true or false). Press Enter for the default (false).\r\ndisable_hashcheck> "]
[350.642, "o", "\r\n\r\nEdit advanced config?\r\ny) Yes\r\nn) No (default)\r\ny/n> "]
[361.284, "o", "n\r\n\r\n"]
[361.288, "o", "Configuration complete.\r\nOptions:\r\n"]
[361.288, "o", "- type: sftp"]
[361.289, "o", "\r\n- host: 134.199.218.139\r\n- user: backup\r\n- port: 2022\r\n- pass: *** ENCRYPTED ***\r\nKeep this \"backup\" remote?\r\ny) Yes this is OK (default)\r\ne) Edit this remote\r\nd) Delete this remote\r\ny/e/d> "]
[368.715, "o", "y\r\n"]
[368.718, "o", "\r\nCurrent remotes:\r\n\r\nName                 Type\r\n====                 ====\r\nbackup               sftp\r\n\r\ne) Edit existing remote\r\nn) New remote\r\nd) Delete remote\r\nr) Rename remote\r\nc) Copy remote\r\ns) Set configuration password\r\nq) Quit config\r\ne/n/d/r/c/s/q> "]
[382.603, "o", "q\r\n"]
