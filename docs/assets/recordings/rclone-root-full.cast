[990.562, "o", "\r\n[Recording note: SSH reconnected after reboot.]\r\nroot@zfsify\\[\\e[0m\\]:\\w# "]
[990.617, "o", "\r\n\u001b[?2004l\r\u001b[H\u001b[2J\u001b[3J\u001b[?2004h\u001b[1;32mroot@zfsify\u001b[0m:~# "]
[990.63, "o", "findmnt -n -o SOURCE,FSTYPE /; findmnt -n -o SOURCE,FSTYPE --target /boot; zpool status -x\r\n\u001b[?2004l\r"]
