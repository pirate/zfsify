[0.727, "o", "\u001b[?2004l\r"]
[0.734, "o", "\u001b[H\u001b[2J\u001b[3J"]
[0.736, "o", "\u001b[?2004h\u001b[1;32mroot@zfsify\u001b[0m:~# "]
[18.875, "o", "# Ubuntu 24.04 / 1 GiB RAM / 25 GiB disk on DigitalOcean\r\n"]
[18.877, "o", "\u001b[?2004l\r\u001b[?2004h"]
[18.877, "o", "\u001b[1;32mroot@zfsify\u001b[0m:~# # Fixture: 12.2 GiB of compressible, allocated data plus a hard link."]
[18.877, "o", "\r\n\u001b[?2004l\r"]
[18.877, "o", "\u001b[?2004h"]
[18.877, "o", "\u001b[1;32mroot@zfsify\u001b[0m:~# "]
[18.877, "o", "df -h /; du -h /srv/demo/archive.bin"]
[18.88, "o", "\r\n\u001b[?2004l\r"]
[18.884, "o", "Filesystem      Size  Used Avail Use% Mounted on"]
[18.885, "o", "\r\n"]
[18.885, "o", "/dev/vda1        24G   15G  9.1G  62% /\r\n"]
[18.892, "o", "13G\t/srv/demo/archive.bin\r\n"]
[18.893, "o", "\u001b[?2004h\u001b[1;32mroot@zfsify\u001b[0m:~# curl -fsSL http://127.0.0.1:8765/reformat.sh | sh"]
[18.893, "o", "\r\n\u001b[?2004l\r"]
[19.183, "o", "Root filesystem: /dev/vda1 on /dev/vda | used 60.99% (15177285632 / 24883167232 bytes)\r\n"]
[19.191, "o", "!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!\r\n!! WARNING: ROOT IS AT LEAST 50% USED. PRESERVATION IS NOT ELIGIBLE.     !!\r\n!! A: rclone backup, verify, reformat, then restore the full system.    !!"]
[19.191, "o", "\r\n"]
[19.193, "o", "!! B: erase and install fresh Ubuntu with a limited priority restore.   !!\r\n!! Applications and data are deleted. /etc, users, SSH keys and        !!\r\n!! basic settings survive. There is no automatic fallback to erasure. !!\r\n"]
[19.193, "o", "!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!"]
[19.194, "o", "\r\n"]
[19.194, "o", "Choose A for rclone backup/restore, or B (or y) for an ERASE install: "]
[34.4, "o", "A\r\n"]
[34.582, "o", "NAME    PATH        SIZE FSTYPE MOUNTPOINTS"]
[34.584, "o", "\r\nvda     /dev/vda     25G        \r\n|-vda1  /dev/vda1    24G ext4   /\r\n|-vda14 /dev/vda14    4M        \r\n|-vda15 /dev/vda15  106M vfat   /boot/efi"]
[34.584, "o", "\r\n`-vda16 /dev/vda16  913M ext4   /boot\r\n"]
[34.585, "o", "BACKUP AND RESTORE: offline tar archive -> rclone remote -> full read-back verification -> erase /dev/vda -> ZFS -> restore archive.\r\nThe remote backup remains available after completion.\r\n"]
[34.587, "o", "10 phases: preflight > prepare RAM > stage reboot > shrink/format > copy"]
[34.587, "o", "\r\n           > checksum verify > configure boot > relocate > expand > finish\r\nLive status includes logical copy bytes, MB/s and block-device IOPS.\r\nSSH disconnects at reboot. Reconnect and run: zfs-on-boot-status\r\nPackage/metadata phases have no meaningful byte total and show n/a.\r\n"]
[34.589, "o", "\rStarting backup in 15s. Press Ctrl-C to cancel. "]
